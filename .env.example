# Copy to .env at the repo root. The Expo app reads apps/mobile/.env (EXPO_PUBLIC_* only).

# --- Supabase ---
# Project URL from the Supabase dashboard. Use the publishable key in the app
# and on the server for user-scoped requests. The secret key stays on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- API ---
PORT=4000
PUBLIC_URL=http://localhost:4000
# Comma-separated. The native app does not need CORS; this is for local tools.
CORS_ORIGIN=*

# Leave REDIS_URL empty to run an in-process queue (no Docker required).
# With Docker: redis://redis:6379
REDIS_URL=
# Set to false when the worker runs as its own process (see docker-compose.yml).
RUN_WORKER=true

# --- LLM ---
# Used when a user has not saved their own key in Settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1-mini
# 32+ character secret used to encrypt bring-your-own LLM keys at rest.
ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Nango ---
# Secret key from the Nango dashboard (cloud or self-hosted).
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev
# Integration IDs configured in Nango. Change these if your integration IDs differ.
NANGO_INTEGRATION_GMAIL=google-mail
NANGO_INTEGRATION_GCAL=google-calendar
NANGO_INTEGRATION_SLACK=slack
NANGO_INTEGRATION_NOTION=notion
NANGO_INTEGRATION_EXCEL=microsoft

# --- Expo push (optional; Expo's push API does not require a secret for basic sends) ---
EXPO_ACCESS_TOKEN=

# --- Mobile (apps/mobile/.env) ---
# EXPO_PUBLIC_API_URL=http://localhost:4000
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# On a physical iPhone, use your computer's LAN IP instead of localhost.
